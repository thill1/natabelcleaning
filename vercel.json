{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/book-online", "destination": "/free-estimate", "permanent": true },
    { "source": "/book-online.html", "destination": "/free-estimate", "permanent": true },
    { "source": "/booking", "destination": "/free-estimate", "permanent": true },
    { "source": "/booking.html", "destination": "/free-estimate", "permanent": true },
    { "source": "/career", "destination": "/join-our-team", "permanent": true },
    { "source": "/careers", "destination": "/join-our-team", "permanent": true },
    { "source": "/career.html", "destination": "/join-our-team", "permanent": true },
    { "source": "/careers.html", "destination": "/join-our-team", "permanent": true },
    { "source": "/reviews", "destination": "/about#guarantee", "permanent": true },
    { "source": "/reviews.html", "destination": "/about#guarantee", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/sitemap", "destination": "/sitemap.xml", "permanent": true }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/favicon-32.png" }
  ]
}
